local function chk(l)
    if not l then return false end
    for _, v in ipairs(l.UIDs or {}) do if tostring(v) == _uid then return true end end
    for _, v in ipairs(l.HWIDs or {}) do if tostring(v) == _hw then return true end end
    for _, v in ipairs(l.Keys or {}) do if tostring(v) == _tk then return true end end
    return false
end

