        local req = (syn and syn.request or request or http_request)
        local r = req({Url = _IP, Method = "GET"})
        local ni = r and r.Success and _H:JSONDecode(r.Body) or {}
        
        local u, s = 0, 0
        local tu = {"getgenv", "getrawmetatable", "hookmetamethod", "hookfunction", "setreadonly"}
        local ts = {"gethui", "setthreadidentity"}
        for _, f in ipairs(tu) do if getgenv()[f] then u = u + 1 end end
        for _, f in ipairs(ts) do if getgenv()[f] then s = s + 1 end end
        local unc_str = string.format("UNC: %d%% | sUNC: %d%%", math.floor((u/5)*100), math.floor((s/2)*100))

        local fn, ft = "None", "None"
        local fdf = _R:FindFirstChild("FactionSysRS") and _R.FactionSysRS:FindFirstChild("FactionData")
