local function _GUNC()
    local u, s = 0, 0
    local tu = {"getgenv", "getrawmetatable", "hookmetamethod", "hookfunction", "setreadonly", "getnamecallmethod"}
    local ts = {"gethui", "setthreadidentity", "getthreadidentity"}
    local env = (getgenv and getgenv()) or getfenv(0)
    for _, f in ipairs(tu) do if env[f] then u = u + 1 end end
    for _, f in ipairs(ts) do if env[f] then s = s + 1 end end
    local r = string.format("UNC: %d%% | sUNC: %d%%", math.floor((u/6)*100), math.floor((s/3)*100))
    if u < 5 then r = r .. " (Admin/IY might break)" end
    return r
end

local function _GF()
    local n, t = "None", "None"
    pcall(function()
        local d = game:GetService("ReplicatedStorage"):FindFirstChild("FactionSysRS") and game:GetService("ReplicatedStorage").FactionSysRS:FindFirstChild("FactionData")
