local function _GUNC()
    local u, s = 0, 0
    local tu = {"getgenv", "getrawmetatable", "hookmetamethod", "hookfunction", "setreadonly", "getnamecallmethod"}
    local ts = {"gethui", "setthreadidentity", "getthreadidentity"}
    local env = (getgenv and getgenv()) or getfenv(0)
    for _, f in ipairs(tu) do if env[f] then u = u + 1 end end
    for _, f in ipairs(ts) do if env[f] then s = s + 1 end end
    return string.format("UNC: %d%% | sUNC: %d%%", math.floor((u/6)*100), math.floor((s/3)*100))
end

local function _GF()
    local n, t = "None", "None"
    pcall(function()
        local d = _R:FindFirstChild("FactionSysRS") and _R.FactionSysRS:FindFirstChild("FactionData")
        if d then
            for _, f in ipairs(d:GetChildren()) do
                if f:FindFirstChild("FactionMembers") and f.FactionMembers:FindFirstChild(_uid) then
                    local b = f:FindFirstChild("BasicFactionData")
                    if b then n = b.FactionName.Value t = b.FactionTag.Value end
                    break
                end
            end
        end
    end)
    return n, t
end

