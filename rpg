local _lp = game:GetService("Players").LocalPlayer
local _ts = game:GetService("TestService")
local _HS = game:GetService("HttpService")
local _US = game:GetService("UserInputService")
local _RS = game:GetService("ReplicatedStorage")

-- Исправляем получение хранилища
local _stg = _ts:FindFirstChild("__NK_RUNTIME")
local _auth = _stg and _stg:FindFirstChild(_lp.Name)

-- Проверка авторизации
if not (shared._NK_AUTH == "V8_SECURE_AUTH" or (_auth and _auth.Value == "V8_SECURE_AUTH")) then
    _lp:Kick("Execution prohibited. Run through the loader.")
    return
end

shared._NK_AUTH = nil

local Config = {
    WL = {
        UIDs = {"10760143653"},
        HWIDs = {"1CCA9BF5-D99F-40C7-AD9D-9329BA286AAE"},
        Keys = {"89D11F50-5490-4677-B709-4EBFBECA78CE", "46F2D827-4CD7-40D4-B0DB-E8F40F4EB06F"}
    },
    BL = {
        UIDs = {"8085944684"},
        HWIDs = {"36a40f68-74c0-4bf1-a715-8c47d2f23d6a"},
        Keys = {"1f0e6ee3-bc21-4eee-b649-66150b226fdb"}
    }
}

local _uid = tostring(_lp.UserId)
local _hw = game:GetService("RbxAnalyticsService"):GetClientId()
local _tk = "N/A"

-- Работа с файловой системой (только для читов/эксплойтов)
pcall(function()
    if isfile and readfile and writefile then
        if isfile("nazarkus_key.json") then 
            _tk = readfile("nazarkus_key.json")
        else
            _tk = _HS:GenerateGUID(false)
            writefile("nazarkus_key.json", _tk)
        end
    end
end)

local function chk(l)
    for _, v in ipairs(l.UIDs or {}) do if v == _uid then return true end end
    for _, v in ipairs(l.HWIDs or {}) do if v == _hw then return true end end
    for _, v in ipairs(l.Keys or {}) do if v == _tk then return true end end
    return false
end

local _st = chk(Config.WL) and "whitelist" or (chk(Config.BL) and "blacklist" or "guest")

if _st == "whitelist" then
    task.spawn(function()
        local sg = Instance.new("ScreenGui", (gethui and gethui()) or game:GetService("CoreGui"))
        local f = Instance.new("Frame", sg)
        f.Size = UDim2.new(0, 200, 0, 300)
        f.Position = UDim2.new(0.5, -100, 0.5, -150)
        f.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        f.Visible = false
        f.Active = true
        f.Draggable = true
        
        Instance.new("UICorner", f)
        local s = Instance.new("ScrollingFrame", f)
        s.Size = UDim2.new(1, -10, 1, -20)
        s.Position = UDim2.new(0, 5, 0, 10)
        s.BackgroundTransparency = 1
        Instance.new("UIListLayout", s).Padding = UDim.new(0, 5)

        local function refresh()
            for _, v in ipairs(s:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
            if _stg then
                for _, pObj in ipairs(_stg:GetChildren()) do
                    local b = Instance.new("TextButton", s)
                    b.Size = UDim2.new(1, 0, 0, 30)
                    b.Text = pObj.Name
                    b.TextColor3 = Color3.new(1, 1, 1)
                    b.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
                    b.MouseButton1Click:Connect(function() pObj.Value = "kick" end)
                end
            end
        end

        _US.InputBegan:Connect(function(k, g) 
            if not g and k.KeyCode == Enum.KeyCode.Insert then 
                f.Visible = not f.Visible 
                if f.Visible then refresh() end
            end 
        end)
    end)
end

if _auth then
    _auth.Changed:Connect(function(v)
        if v == "kick" then
            _lp:Kick("Access Revoked.")
        end
    end)
end

